{
  "name": "amrutamsuperapp",
  "version": "1.0.0",
  "main": "./index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "start:development": "cp .env.development .env.local && cross-env APP_ENV=development EXPO_PUBLIC_APP_ENV=development expo start --dev-client",
    "start:staging": "cp .env.staging .env.local && cross-env APP_ENV=staging EXPO_PUBLIC_APP_ENV=staging expo start --dev-client",
    "start:production": "cp .env.production .env.local && cross-env APP_ENV=production EXPO_PUBLIC_APP_ENV=production expo start --dev-client",
    "android": "expo run:android",
    "android:development": "cp .env.development .env.local && cross-env APP_ENV=development EXPO_PUBLIC_APP_ENV=development expo run:android",
    "android:staging": "cp .env.staging .env.local && cross-env APP_ENV=staging EXPO_PUBLIC_APP_ENV=staging expo run:android",
    "android:production": "cp .env.production .env.local && cross-env APP_ENV=production EXPO_PUBLIC_APP_ENV=production expo run:android",
    "ios": "expo run:ios",
    "ios:development": "cp .env.development .env.local && cross-env APP_ENV=development EXPO_PUBLIC_APP_ENV=development expo run:ios",
    "ios:staging": "cp .env.staging .env.local && cross-env APP_ENV=staging EXPO_PUBLIC_APP_ENV=staging expo run:ios",
    "ios:production": "cp .env.production .env.local && cross-env APP_ENV=production EXPO_PUBLIC_APP_ENV=production expo run:ios",
    "prebuild": "expo prebuild",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.3.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "@tanstack/react-query": "^5.90.16",
    "@types/react": "~19.2.10",
    "axios": "^1.6.8",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^7.0.3",
    "dotenv": "~16.4.5",
    "expo": "^57.0.1",
    "expo-build-properties": "~57.0.2",
    "expo-constants": "~57.0.2",
    "expo-dev-client": "~57.0.4",
    "expo-device": "^57.0.1",
    "expo-font": "~57.0.0",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.1",
    "expo-localization": "~57.0.0",
    "expo-notifications": "^57.0.15",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~57.0.0",
    "expo-sharing": "~57.0.16",
    "expo-splash-screen": "~57.0.1",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "i18next": "^25.8.0",
    "patch-package": "^8.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-i18next": "^16.5.3",
    "react-native": "0.86.3",
    "react-native-edge-to-edge": "1.6.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "4.1.1",
    "react-native-nitro-modules": "0.33.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-toast-message": "^2.3.0",
    "react-native-unistyles": "3.0.22",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@react-native/jest-preset": "^0.87.1",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-native-unistyles": "^3.0.7",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "jest": "^30.3.0",
    "jest-expo": "~57.0.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.62.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  },
  "private": true
}
